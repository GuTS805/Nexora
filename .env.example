# Nexora uses Tiramisu TEST wallets only. `npm run wallets` creates these in .env.local
# (gitignored) for you. Never commit real values, and never prefix them with VITE_: anything
# prefixed VITE_ is bundled into the browser.

# Gas sponsor + demo trust-list curator. Also set as a secret on the deployment for web/api/sponsor.ts.
NEXORA_SPONSOR_KEY=

# Synthetic demo publishers used by `npm run seed` (4 is the deliberate spammer).
NEXORA_SEED_KEY_1=
NEXORA_SEED_KEY_2=
NEXORA_SEED_KEY_3=
NEXORA_SEED_KEY_4=

# Optional: GLM sent to each new visitor wallet by the sponsor (default 0.01).
SPONSOR_DRIP_GLM=

# Optional: Arkiv RPC with an Arkiv Hub access key (https://hub.arkiv.network/api-keys), used by the
# CLI, scripts and the gas sponsor. The anonymous public RPC has a small query budget per IP.
# Never put a keyed URL in the browser: keys in a web page can be read and spent by anyone.
ARKIV_RPC_URL=
ARKIV_WS_URL=
