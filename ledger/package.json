{
  "name": "nexora-ledger",
  "version": "0.9.0",
  "description": "Open data contract for Nexora gig-worker earnings and incident entities on Arkiv: JSON Schemas, codec, sealing, queries, insights and a public privacy audit.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/GuTS805/Nexora.git", "directory": "ledger" },
  "homepage": "https://github.com/GuTS805/Nexora/tree/main/ledger#readme",
  "bugs": "https://github.com/GuTS805/Nexora/issues",
  "keywords": ["arkiv", "gig-workers", "india", "open-data", "privacy", "json-schema"],
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "nexora-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./contract": {
      "nexora-source": "./src/contract.ts",
      "types": "./dist/src/contract.d.ts",
      "default": "./dist/src/contract.js"
    },
    "./schema/*.json": "./schema/*.json",
    "./vectors.json": "./vectors.json"
  },
  "bin": {
    "nexora": "./dist/cli.js"
  },
  "files": ["dist", "schema", "vectors.json", "CHANGELOG.md", "README.md", "LICENSE"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx cli.ts",
    "schemas": "tsx write-schemas.ts",
    "vectors": "tsx vectors.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build && node -e \"const fs=require('fs');fs.cpSync('../arkiv/schema','schema',{recursive:true});fs.copyFileSync('../arkiv/vectors/vectors.json','vectors.json');fs.copyFileSync('../LICENSE','LICENSE')\"",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "ajv": "^8.20.0",
    "viem": "^2.57.11"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
