{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GuTS805/Nexora/main/arkiv/schema/trust-list.schema.json",
  "title": "Nexora trust list (v1)",
  "description": "Wallets a union or group vouches for. Editable by its owner only; the curator chooses its public name and description.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contentType",
    "flags",
    "attributes",
    "payload"
  ],
  "properties": {
    "contentType": {
      "const": "application/json"
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readonly",
        "permissionlessExtension"
      ],
      "properties": {
        "readonly": {
          "const": false
        },
        "permissionlessExtension": {
          "const": false
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "v",
        "kind",
        "name",
        "scope"
      ],
      "properties": {
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "const": "nexora"
            }
          }
        },
        "v": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "i32"
            },
            "value": {
              "const": 1
            }
          }
        },
        "kind": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "const": "trust_list"
            }
          }
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "type": "string",
              "minLength": 3,
              "maxLength": 48
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "enum": [
                "food_delivery",
                "grocery_delivery",
                "parcel_delivery",
                "cab",
                "bike_taxi",
                "auto",
                "home_services",
                "all"
              ]
            }
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "description",
        "members"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "description": {
          "type": "string",
          "maxLength": 280
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "minItems": 1,
          "maxItems": 25,
          "uniqueItems": true
        }
      }
    }
  }
}
