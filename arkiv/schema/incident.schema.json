{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GuTS805/Nexora/main/arkiv/schema/incident.schema.json",
  "title": "Nexora incident report (v1)",
  "description": "Something that happened to a worker: an ID block, a pay cut, a penalty. Closed vocabulary only; any free text is sealed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contentType",
    "flags",
    "attributes",
    "payload"
  ],
  "properties": {
    "contentType": {
      "const": "application/json"
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readonly",
        "permissionlessExtension"
      ],
      "properties": {
        "readonly": {
          "const": true
        },
        "permissionlessExtension": {
          "const": true
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "v",
        "kind",
        "platform",
        "work",
        "city",
        "type",
        "period",
        "days_lost",
        "demo"
      ],
      "properties": {
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "const": "nexora"
            }
          }
        },
        "v": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "i32"
            },
            "value": {
              "const": 1
            }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "enum": [
                "swiggy",
                "zomato",
                "blinkit",
                "zepto",
                "bigbasket",
                "amazon",
                "flipkart",
                "uber",
                "ola",
                "rapido",
                "porter",
                "urban_company",
                "other"
              ]
            }
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "enum": [
                "food_delivery",
                "grocery_delivery",
                "parcel_delivery",
                "cab",
                "bike_taxi",
                "auto",
                "home_services"
              ]
            }
          }
        },
        "city": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "enum": [
                "delhi_ncr",
                "mumbai",
                "bengaluru",
                "hyderabad",
                "chennai",
                "kolkata",
                "pune",
                "ahmedabad",
                "jaipur",
                "lucknow",
                "indore",
                "kochi",
                "chandigarh",
                "other_city"
              ]
            }
          }
        },
        "period": {
          "type": "object",
          "description": "Month worked, YYYYMM.",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "i32"
            },
            "value": {
              "enum": [
                202401,
                202402,
                202403,
                202404,
                202405,
                202406,
                202407,
                202408,
                202409,
                202410,
                202411,
                202412,
                202501,
                202502,
                202503,
                202504,
                202505,
                202506,
                202507,
                202508,
                202509,
                202510,
                202511,
                202512,
                202601,
                202602,
                202603,
                202604,
                202605,
                202606,
                202607,
                202608,
                202609,
                202610,
                202611,
                202612,
                202701,
                202702,
                202703,
                202704,
                202705,
                202706,
                202707,
                202708,
                202709,
                202710,
                202711,
                202712,
                202801,
                202802,
                202803,
                202804,
                202805,
                202806,
                202807,
                202808,
                202809,
                202810,
                202811,
                202812,
                202901,
                202902,
                202903,
                202904,
                202905,
                202906,
                202907,
                202908,
                202909,
                202910,
                202911,
                202912,
                203001,
                203002,
                203003,
                203004,
                203005,
                203006,
                203007,
                203008,
                203009,
                203010,
                203011,
                203012
              ]
            }
          }
        },
        "demo": {
          "type": "object",
          "description": "True for synthetic demo data.",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        "kind": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "const": "incident"
            }
          }
        },
        "type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "str"
            },
            "value": {
              "enum": [
                "id_blocked",
                "deactivated",
                "pay_cut",
                "incentive_cut",
                "penalty",
                "payout_delayed",
                "unsafe_pressure",
                "harassment"
              ]
            }
          }
        },
        "days_lost": {
          "type": "object",
          "description": "Days without work because of it.",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "i32"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 90
            }
          }
        },
        "parent": {
          "type": "object",
          "description": "The earlier report this one updates or seconds.",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "key"
            },
            "value": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "reasonGiven",
        "appealed",
        "resolved"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "reasonGiven": {
          "type": "boolean"
        },
        "appealed": {
          "type": "boolean"
        },
        "resolved": {
          "type": "boolean"
        },
        "sealed": {
          "type": "object",
          "description": "Exact figures or notes the worker chose to keep, AES-256-GCM encrypted on their device. Only someone with the passphrase can open it.",
          "additionalProperties": false,
          "required": [
            "alg",
            "kdf",
            "iter",
            "salt",
            "iv",
            "ct"
          ],
          "properties": {
            "alg": {
              "const": "AES-256-GCM"
            },
            "kdf": {
              "const": "PBKDF2-SHA256"
            },
            "iter": {
              "type": "integer",
              "minimum": 100000,
              "maximum": 5000000
            },
            "salt": {
              "type": "string",
              "description": "16 random bytes, base64.",
              "pattern": "^[A-Za-z0-9+/]{22}==$"
            },
            "iv": {
              "type": "string",
              "description": "12 random bytes, base64.",
              "pattern": "^[A-Za-z0-9+/]{16}$"
            },
            "ct": {
              "type": "string",
              "description": "Ciphertext and GCM tag, base64.",
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "maxLength": 7999
            }
          }
        }
      }
    }
  }
}
